# Notes Game - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# The server loads .env automatically via dotenv. Place .env in the server/ folder
# (or project root; dotenv loads from the current working directory when the server starts).

# ============== Server (required in production) ==============

# Required in production. Use a long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=

# API server port (default: 3001)
API_PORT=3001

# Socket.io server port (default: 3002)
IO_PORT=3002

# Allowed CORS origin (client URL). Must match where the React app is served from.
# Examples: http://localhost:3000, https://your-app.com
CLIENT_URL=http://localhost:3000

# Optional: reCAPTCHA secret key for server-side verification (required when captcha is enabled)
# CAPTCHA_SECRET_KEY=

# Set to 'true' to disable captcha (e.g. for development). Captcha is also disabled when NODE_ENV !== 'production'.
# DISABLE_CAPTCHA=true

# ============== Email (for verification emails) ==============
# Set to 'true' to skip email verification (dev/AI testing only). When set, register creates users immediately.
# SKIP_EMAIL_VERIFICATION=true

# Required for sending verification emails. Without these, the verification link is logged to console.
# EMAIL_FROM=
# EMAIL_CLIENT_ID=
# EMAIL_CLIENT_SECRET=
# EMAIL_REFRESH_TOKEN=
# EMAIL_ACCESS_TOKEN=

# ============== Client (build-time) ==============
# These are used when building the React app. Create React App uses REACT_APP_ prefix.
# For production builds, set these before running: npm run build
# For local dev, defaults in Config.ts are used if not set.

# REACT_APP_API_ROOT=http://localhost:3001/
# REACT_APP_SOCKET_ROOT=http://localhost:3002/
# REACT_APP_RECAPTCHA_SITE_KEY=
