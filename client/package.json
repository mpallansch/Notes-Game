{
  "name": "death-card-react-client",
  "version": "0.0.1",
  "private": true,
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rollup-plugin-terser": "npm:@rollup/plugin-terser@^0.4.4",
    "nth-check": "2.0.1",
    "postcss": "8.4.31"
  },
  "dependencies": {
    "copyfiles": "^2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^6.6.2",
    "react-scripts": "^5.0.1",
    "rollup": "^4.57.1",
    "socket.io-client": "^4.5.4",
    "web-vitals": "^3.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "dev": "dotenv -e .env.development react-scripts build && copyfiles --up 1 build/**/*.* ../server/src/public/",
    "postinstall": "patch-package && npx update-browserslist-db@latest"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.2.5",
    "@types/node": "^18.11.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^7.0.0",
    "patch-package": "^8.0.1",
    "sass": "^1.69.0",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.5",
    "typescript": "^4.9.4",
    "webpack-dev-server": "^5.2.3"
  }
}
